---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { experience, home, projects } from "../lib/content";
import "../styles/global.css";

const year = new Date().getFullYear();
const { profile, seo } = home;
---

<BaseLayout
  title={seo?.meta_title ?? `${profile.name} | ${profile.headline}`}
  description={seo?.meta_description ?? profile.short_tagline}
  person={{
    name: profile.name,
    jobTitle: profile.headline,
    email: profile.email,
    location: profile.location,
    sameAs: [profile.linkedin_url, profile.github_url],
  }}
>
  <Nav name={profile.name} resumeUrl={profile.resume_url} />
  <main id="main">
    <Hero home={home} />
    <About home={home} />
    <Experience experience={experience} />
    <Projects projects={projects} />
    <Skills home={home} />
    <Contact home={home} />
  </main>
  <Footer name={profile.name} year={year} />
</BaseLayout>
