---
/**
 * Illustrative quantile forecast drawn at build time. The series is
 * synthetic (seeded, deterministic): daily values with weekly seasonality,
 * then a 28-day forecast with P10–P90 / P25–P75 bands and realized values.
 */
const W = 640;
const H = 400;
const pad = { top: 18, right: 52, bottom: 40, left: 6 };
const HIST = 49;
const HORIZON = 28;
const SIGMA = 2.3;

function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20260708);
const gauss = () => {
  const u = 1 - rand();
  const v = rand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};

const signal = (t: number) =>
  100 +
  0.22 * t +
  7 * Math.sin((2 * Math.PI * (t + 4)) / 34) +
  2.2 * Math.sin((2 * Math.PI * t) / 7);

const actual = Array.from({ length: HIST }, (_, t) => signal(t) + SIGMA * gauss());
const origin = HIST - 1;
const last = actual[origin];

type Step = { t: number; p10: number; p25: number; p50: number; p75: number; p90: number };
const steps: Step[] = [{ t: origin, p10: last, p25: last, p50: last, p75: last, p90: last }];
const realized: { t: number; y: number }[] = [];
for (let h = 1; h <= HORIZON; h++) {
  const t = origin + h;
  const p50 = signal(t);
  const s = SIGMA * Math.sqrt(1 + h / 5);
  steps.push({
    t,
    p10: p50 - 1.2816 * s,
    p25: p50 - 0.6745 * s,
    p50,
    p75: p50 + 0.6745 * s,
    p90: p50 + 1.2816 * s,
  });
  realized.push({ t, y: p50 + SIGMA * Math.sqrt(1 + h / 5) * gauss() });
}

const ys = [...actual, ...steps.flatMap((s) => [s.p10, s.p90]), ...realized.map((r) => r.y)];
const yMin = Math.min(...ys);
const yMax = Math.max(...ys);
const span = yMax - yMin;
const lo = yMin - span * 0.06;
const hi = yMax + span * 0.06;

const tMax = origin + HORIZON;
const x = (t: number) => pad.left + (t / tMax) * (W - pad.left - pad.right);
const y = (v: number) => pad.top + (1 - (v - lo) / (hi - lo)) * (H - pad.top - pad.bottom);
const f = (n: number) => n.toFixed(1);

const line = (pts: [number, number][]) =>
  pts.map(([px, py], i) => `${i ? "L" : "M"}${f(px)} ${f(py)}`).join("");
const band = (upper: (s: Step) => number, lower: (s: Step) => number) =>
  line(steps.map((s) => [x(s.t), y(upper(s))])) +
  steps
    .slice()
    .reverse()
    .map((s) => `L${f(x(s.t))} ${f(y(lower(s)))}`)
    .join("") +
  "Z";

const actualPath = line(actual.map((v, t) => [x(t), y(v)]));
const medianPath = line(steps.map((s) => [x(s.t), y(s.p50)]));
const outerBand = band((s) => s.p90, (s) => s.p10);
const innerBand = band((s) => s.p75, (s) => s.p25);

const end = steps[steps.length - 1];
const plotBottom = H - pad.bottom;
const gridYs = [0, 1, 2, 3].map((i) => pad.top + (i / 3) * (plotBottom - pad.top));
const ox = x(origin);
const xEnd = x(tMax);
---

<svg
  class="hc"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-labelledby="hc-title"
  preserveAspectRatio="xMidYMid meet"
>
  <title id="hc-title">
    Illustrative quantile forecast: seven weeks of observed daily values,
    followed by a four-week forecast with P10 to P90 and P25 to P75 bands
    and the values that were later observed.
  </title>
  <defs>
    <clipPath id="hc-clip">
      <rect class="hc-clip-rect" x={f(ox)} y="0" width={f(W - ox)} height={H}></rect>
    </clipPath>
  </defs>

  <g class="hc-grid" aria-hidden="true">
    {gridYs.map((gy) => <line x1={pad.left} x2={f(xEnd)} y1={f(gy)} y2={f(gy)} />)}
  </g>

  <line class="hc-origin" x1={f(ox)} x2={f(ox)} y1={pad.top} y2={plotBottom} aria-hidden="true"></line>

  <g class="hc-forecast" clip-path="url(#hc-clip)" aria-hidden="true">
    <path class="hc-band--outer" d={outerBand}></path>
    <path class="hc-band--inner" d={innerBand}></path>
    <path class="hc-median" d={medianPath}></path>
  </g>

  <path class="hc-actual" d={actualPath} pathLength="1" aria-hidden="true"></path>

  <g class="hc-realized" aria-hidden="true">
    {realized.map((r) => <circle cx={f(x(r.t))} cy={f(y(r.y))} r="2.6" />)}
  </g>

  <g class="hc-late" aria-hidden="true">
    <text class="hc-label" x={f(xEnd + 8)} y={f(y(end.p90) + 4)}>P90</text>
    <text class="hc-label hc-label--strong" x={f(xEnd + 8)} y={f(y(end.p50) + 4)}>P50</text>
    <text class="hc-label" x={f(xEnd + 8)} y={f(y(end.p10) + 4)}>P10</text>
  </g>

  <g aria-hidden="true">
    <text class="hc-label" x={f(pad.left)} y={H - 12}>Observed</text>
    <text class="hc-label" x={f(ox + 10)} y={H - 12}>Forecast</text>
  </g>
</svg>
