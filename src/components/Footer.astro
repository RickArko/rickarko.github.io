---
interface Props {
  name: string;
  year: number;
}

const { name, year } = Astro.props;
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {name}. Also at <a href="https://rickarko.com">rickarko.com</a>.</p>
    <p>
      Built with Astro and deployed on GitHub Pages.{" "}
      <a href="https://github.com/RickArko/rickarko.github.io">View the source</a>.
    </p>
  </div>
</footer>
