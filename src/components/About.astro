---
import type { Home } from "../lib/content";

interface Props {
  home: Home;
}

const { home } = Astro.props;
---

<section class="section section--alt" id="about">
  <div class="container">
    <div class="about__header">
      <img
        class="about__portrait"
        src="/images/profile-image.png"
        alt={`Portrait of ${home.profile.name}`}
        width="480"
        height="600"
        loading="lazy"
      />
      <div class="about__intro">
        <span class="section__eyebrow">About</span>
        <h2 class="section__title">Builder / senior IC</h2>
        <div class="about__copy">
          {home.about.map((para) => <p>{para}</p>)}
        </div>
      </div>
    </div>
    <div class="about__grid">
      {
        home.wins.map((win) => (
          <article class="about__card">
            <h3>{win.title}</h3>
            <p>{win.impact}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
