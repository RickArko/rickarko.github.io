---
import type { Home } from "../lib/content";

interface Props {
  home: Home;
}

const { home } = Astro.props;
---

<section class="section" id="about">
  <div class="container about">
    <picture>
      <source srcset="/images/profile-image.webp" type="image/webp" />
      <img
        class="about__portrait"
        src="/images/profile-image.png"
        alt={`Portrait of ${home.profile.name}`}
        width="480"
        height="600"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div>
      <h2 class="section__title">About</h2>
      <div class="about__copy">
        {home.about.map((para) => <p>{para}</p>)}
      </div>
      {
        home.facts.length > 0 && (
          <dl class="facts">
            {home.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
