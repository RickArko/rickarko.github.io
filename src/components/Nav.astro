---
interface Props {
  name: string;
  resumeUrl: string;
}

const { name, resumeUrl } = Astro.props;

const links: { href: string; label: string; hideSm?: boolean }[] = [
  { href: "#about", label: "About", hideSm: true },
  { href: "#experience", label: "Experience", hideSm: true },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills", hideSm: true },
  { href: "#contact", label: "Contact" },
];
---

<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href="#top">{name}</a>
    <nav aria-label="Primary">
      <ul class="nav__links">
        {
          links.map((link) => (
            <li class:list={[link.hideSm && "nav__hide-sm"]}>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a class="btn btn--ghost nav__resume" href={resumeUrl}>Resume</a>
        </li>
      </ul>
    </nav>
  </div>
</header>
