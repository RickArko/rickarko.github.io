---
interface Props {
  name: string;
}

const { name } = Astro.props;

const links: { href: string; label: string; keep?: boolean }[] = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact", keep: true },
];
---

<header class="site-nav">
  <div class="container site-nav__inner">
    <a class="site-nav__brand" href="#top">{name}</a>
    <nav aria-label="Primary">
      <ul class="site-nav__links">
        {
          links.map((link) => (
            <li class:list={[link.keep && "site-nav__keep"]}>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li class="site-nav__keep">
          <a
            class="btn btn--ghost site-nav__resume"
            href="/downloads/resume-generic-media.pdf"
            >Résumé</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>
