---
import type { Home } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  home: Home;
}

const { home } = Astro.props;
const { profile, contact } = home;
---

<section class="section" id="contact">
  <div class="container">
    <h2 class="section__title">Contact</h2>
    <p class="section__lead">{contact.intro}</p>
    <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
    <p class="contact__availability">{profile.availability}</p>
    <ul class="contact__links">
      <li>
        <a class="btn btn--primary" href={`mailto:${profile.email}`}>
          <Icon name="mail" />
          {contact.primary_cta_label}
        </a>
      </li>
      <li>
        <a class="btn btn--ghost" href={profile.linkedin_url} rel="me noopener">
          <Icon name="linkedin" />
          LinkedIn
        </a>
      </li>
      <li>
        <a class="btn btn--ghost" href={profile.github_url} rel="me noopener">
          <Icon name="github" />
          GitHub
        </a>
      </li>
      <li>
        <a class="btn btn--ghost" href={profile.resume_url}>
          <Icon name="download" />
          Resume (PDF)
        </a>
      </li>
    </ul>
  </div>
</section>
