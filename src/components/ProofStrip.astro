---
import type { Home } from "../lib/content";

interface Props {
  home: Home;
}

const { home } = Astro.props;
---

<section class="section" id="proof" aria-label="Proof points">
  <div class="container">
    <span class="section__eyebrow">Track record</span>
    <h2 class="section__title">Measured in production</h2>
    <div class="proof__stats">
      {
        home.stats.map((stat) => (
          <div class="proof__stat">
            <div class="proof__value">{stat.value}</div>
            <p class="proof__label">{stat.label}</p>
          </div>
        ))
      }
    </div>
    {
      home.proof_logos.length > 0 && (
        <div class="proof__logos" aria-label="Companies">
          {home.proof_logos.map((logo) => (
            <img src={logo.src} alt={logo.name} height="28" />
          ))}
        </div>
      )
    }
  </div>
</section>
