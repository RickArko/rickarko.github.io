---
import type { Experience } from "../lib/content";
import { sortedEmployers } from "../lib/content";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const employers = sortedEmployers(experience);

function monogram(name: string): string {
  return name
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="section" id="experience">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title">{experience.summary.title}</h2>
      {
        experience.summary.description && (
          <p class="section__lead">{experience.summary.description}</p>
        )
      }
    </header>
    <ol class="jobs">
      {
        employers.map((employer) => {
          const multiRole = employer.roles.length > 1;
          const meta = [employer.employer_duration, employer.location]
            .filter(Boolean)
            .join(", ");
          return (
            <li class="job">
              <div class="job__rail">
                {employer.logo ? (
                  <img
                    class="job__logo"
                    src={employer.logo}
                    alt=""
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                ) : (
                  <span class="job__logo job__logo--mono" aria-hidden="true">
                    {monogram(employer.employer_name)}
                  </span>
                )}
              </div>
              <div>
                <header class="job__head">
                  <h3 class="job__employer">{employer.employer_name}</h3>
                  <p class="job__meta">{meta}</p>
                </header>
                {employer.roles.map((role) => (
                  <div class="role">
                    <div class="role__head">
                      <h4 class="role__title">{role.job_title}</h4>
                      {multiRole && <span class="role__dates">{role.duration}</span>}
                    </div>
                    <p class="role__summary">{role.headline}</p>
                    <ul class="role__points">
                      {role.highlights.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
