---
import type { Experience } from "../lib/content";
import { sortedEmployers } from "../lib/content";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const employers = sortedEmployers(experience);

function monogram(name: string): string {
  return name
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="section" id="experience">
  <div class="container">
    <span class="section__eyebrow">Experience</span>
    <h2 class="section__title">{experience.summary.title}</h2>
    <p class="section__lead">
      Roles where models had to ship, stay up, and earn trust from operators.
    </p>
    <div class="exp-list">
      {
        employers.map((employer) => (
          <article class="exp-item">
            <div class="exp-item__rail">
              {employer.logo ? (
                <img
                  class="exp-item__logo"
                  src={employer.logo}
                  alt=""
                  width="56"
                  height="56"
                  loading="lazy"
                />
              ) : (
                <span
                  class="exp-item__logo exp-item__logo--mono"
                  aria-hidden="true"
                >
                  {monogram(employer.employer_name)}
                </span>
              )}
            </div>
            <div class="exp-item__body">
              <header class="exp-item__header">
                <h3 class="exp-item__employer">{employer.employer_name}</h3>
                <span class="exp-item__duration">
                  {employer.employer_duration}
                </span>
              </header>
              {employer.roles.map((role) => (
                <div class="exp-role">
                  <div class="exp-role__row">
                    <h4 class="exp-role__title">{role.job_title}</h4>
                    <span class="exp-role__duration">{role.duration}</span>
                  </div>
                  <p class="exp-role__headline">{role.headline}</p>
                  <ul>
                    {role.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
