---
import type { Projects } from "../lib/content";
import { projectsByTier } from "../lib/content";
import ProjectMedia from "./ProjectMedia.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  projects: Projects;
}

const { projects } = Astro.props;
const { featured, grid, more } = projectsByTier(projects);
---

<section class="section" id="projects">
  <div class="container">
    <header class="section__head">
      <h2 class="section__title">{projects.summary.title}</h2>
      {
        projects.summary.description && (
          <p class="section__lead">{projects.summary.description}</p>
        )
      }
    </header>

    <div class="features">
      {
        featured.map((project) => (
          <article class="feature" id={`project-${project.id}`}>
            <ProjectMedia project={project} />
            <div>
              <h3 class="feature__title">{project.title}</h3>
              {project.tagline && <p class="project__tagline">{project.tagline}</p>}
              <p class="project__desc">{project.description}</p>
              {project.impact && <p class="project__result">{project.impact}</p>}
              {project.engineering && <p class="project__eng">{project.engineering}</p>}
              <ul class="tags" aria-label="Technologies">
                {project.technologies.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>
              <ProjectLinks project={project} />
            </div>
          </article>
        ))
      }
    </div>

    {
      grid.length > 0 && (
        <div class="cards">
          {grid.map((project) => (
            <article class="card" id={`project-${project.id}`}>
              <ProjectMedia project={project} />
              <div class="card__body">
                <h3 class="card__title">{project.title}</h3>
                {project.tagline && <p class="project__tagline">{project.tagline}</p>}
                <p class="project__desc">{project.description}</p>
                {project.impact && <p class="project__result">{project.impact}</p>}
                <ul class="tags" aria-label="Technologies">
                  {project.technologies.slice(0, 5).map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <ProjectLinks project={project} />
              </div>
            </article>
          ))}
        </div>
      )
    }

    {
      more.length > 0 && (
        <div class="more">
          <h3 class="more__title">Also built</h3>
          <ul class="more__list">
            {more.map((project) => (
              <li class="more__item" id={`project-${project.id}`}>
                <h4>{project.title}</h4>
                <p>{project.description}</p>
                <p class="more__tech">{project.technologies.join(", ")}</p>
                <ProjectLinks project={project} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
