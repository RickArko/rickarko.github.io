---
import type { Home } from "../lib/content";
import HeroChart from "./HeroChart.astro";
import Icon from "./Icon.astro";

interface Props {
  home: Home;
}

const { home } = Astro.props;
const { profile, hero } = home;
---

<section class="hero" id="top">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__copy">
        <h1 class="hero__name">{profile.name}</h1>
        <p class="hero__role">{profile.headline}</p>
        <p class="hero__lead">{profile.short_tagline}</p>
        <div class="hero__actions">
          <div class="hero__buttons">
            <a class="btn btn--primary" href={hero.primary_cta.href}>
              {hero.primary_cta.label}
            </a>
            <a class="btn btn--ghost" href={hero.secondary_cta.href}>
              <Icon name="download" />
              {hero.secondary_cta.label}
            </a>
          </div>
          <ul class="hero__social">
            <li>
              <a href={profile.github_url} aria-label="GitHub" rel="me noopener">
                <Icon name="github" />
              </a>
            </li>
            <li>
              <a href={profile.linkedin_url} aria-label="LinkedIn" rel="me noopener">
                <Icon name="linkedin" />
              </a>
            </li>
          </ul>
        </div>
        {profile.current_role && <p class="hero__now">{profile.current_role}</p>}
      </div>
      <figure class="hero__chart">
        <HeroChart />
        {hero.chart_caption && <figcaption>{hero.chart_caption}</figcaption>}
      </figure>
    </div>

    <div class="hero__proof">
      <dl class="stats">
        {
          home.stats.map((stat) => (
            <div class="stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))
        }
      </dl>
      {
        home.proof_logos.length > 0 && (
          <ul class="employers" aria-label="Employers">
            {home.proof_logos.map((logo) => (
              <li>
                <img src={logo.src} alt="" width="32" height="32" />
                {logo.name}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
