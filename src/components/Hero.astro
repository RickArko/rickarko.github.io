---
import type { Home } from "../lib/content";

interface Props {
  home: Home;
}

const { home } = Astro.props;
const { profile, hero } = home;
---

<section class="hero section" id="top">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="section__eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__name">{profile.name}</h1>
      <p class="hero__headline">{profile.headline}</p>
      <p class="hero__tagline">{profile.short_tagline}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={hero.primary_cta.href}
          >{hero.primary_cta.label}</a
        >
        <a class="btn btn--ghost" href={hero.secondary_cta.href}
          >{hero.secondary_cta.label}</a
        >
      </div>
    </div>
    {
      home.proof_logos.length > 0 && (
        <div class="hero__proof" aria-label="Employers">
          <div class="hero__logos">
            {home.proof_logos.map((logo) => (
              <span class="hero__logo">
                <img src={logo.src} alt="" height="40" loading="eager" />
                <span class="hero__logo-name">{logo.name}</span>
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>
