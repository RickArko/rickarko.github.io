---
interface Props {
  title: string;
  description: string;
  person: {
    name: string;
    jobTitle: string;
    email: string;
    location: string;
    sameAs: string[];
  };
}

const { title, description, person } = Astro.props;
const site = Astro.site ?? new URL("https://rickarko.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: person.name,
  jobTitle: person.jobTitle,
  email: `mailto:${person.email}`,
  url: site.href,
  image: new URL("/images/profile-image.png", site).href,
  address: { "@type": "PostalAddress", addressLocality: person.location },
  sameAs: person.sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b1221" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.jobTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,400..800&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      // Play project recordings only while visible, and never for
      // reduced-motion users (they keep the poster frame).
      (function () {
        var videos = document.querySelectorAll("video[data-autoplay]");
        if (!videos.length) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (!("IntersectionObserver" in window)) return;
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              var v = entry.target;
              if (entry.isIntersecting) {
                var p = v.play();
                if (p && p.catch) p.catch(function () {});
              } else {
                v.pause();
              }
            });
          },
          { threshold: 0.35 }
        );
        videos.forEach(function (v) {
          io.observe(v);
        });
      })();
    </script>
  </body>
</html>
